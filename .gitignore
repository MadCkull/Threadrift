# Dependencies
node_modules/
.pnpm-store/
.bun/
.pnp.*
.yarn/install-state.gz

# Generated builds, framework files, caches and deployment state
dist/
build/
out/
.next/
.turbo/
.vercel/
next-env.d.ts
*.tsbuildinfo
.eslintcache
.cache/

# Test and coverage output (test source and fixtures stay versioned)
coverage/
.nyc_output/
playwright-report/
test-results/

# Local environment and credentials; sanitized templates stay versioned
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.template
*.pem
*.key
*.p12
*.pfx

# Local graph recovery, writer locks and atomic-write temporary files
# Keep graph.json and package-manager lockfiles versioned.
**/public/data/*.json.bak
**/public/data/*.json.lock
**/public/data/*.json.*.tmp

# Logs
*.log

# OS and editor files
.DS_Store
Thumbs.db
Desktop.ini
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# Generated analysis and personal working notes
/graphify-out/
/PROJECT_CONTEXT.md
/project-notes/
/AGENTS.md
# .codegraph/.gitignore excludes its machine-local database and daemon files.
